# ============================================
# MindSpeed MM CI Docker Image Build File
#
# Built ON TOP of the dev image (built from Dockerfile).
# Adds multiple conda environments (one per MindSpeed-MM release branch) and
# pre-downloads CI test dependencies (transformers, Megatron-LM) to avoid
# network instability at test time.
#
# Kept as a separate Dockerfile so the dev image stays clean and small, and CI
# builds can extend any published dev image.
# ============================================

ARG DEV_IMAGE
FROM ${DEV_IMAGE}

# tomli is needed to parse pyproject.toml of each branch on Python < 3.11.
RUN pip install tomli

# Copy CI build scripts and version config (context is the docker/ directory).
COPY scripts/ci/ /tmp/ci_scripts/

# To keep the CI build fully independent of the dev image (which does not retain
# the decord source tree), we rebuild decord from source here using the SAME
# script and dependencies as the dev build (install_decord_on_arm.sh). This
# produces a built decord tree at /tmp/decord from which build_ci_envs.py
# compiles the per-python pybind11 bindings for every fresh conda environment.
# Works for any python version (3.12, 3.13, ...): adding one only requires a new
# entry in ci_versions.json. On x86_64 decord comes from pip instead.
COPY common/install_decord_on_arm.sh /tmp/install_decord.sh
COPY decord_deps/ /tmp/decord_deps/

# Create the multi-version conda environments (one per release branch).
# The decord source build (install_decord_on_arm.sh) installs its own build
# tools (gcc/g++/make/cmake/...), which are only needed at build time.
RUN if [ -d /tmp/decord_deps/decord ]; then \
        echo ">>> Building decord from source (aarch64)..." && \
        bash /tmp/install_decord.sh /tmp/decord_deps && \
        echo ">>> Keeping built decord source tree for per-python bindings..." && \
        mkdir -p /opt/decord_src && \
        cp -r /tmp/decord/. /opt/decord_src/ ; \
    else \
        echo ">>> No decord source found (x86_64 or non-ARM); decord will come from pip"; \
    fi && \
    rm -rf /tmp/decord_deps /tmp/install_decord.sh ~/ffmpeg_sources ~/ffmpeg_build ~/bin && \
    python /tmp/ci_scripts/build_ci_envs.py && \
    rm -rf /tmp/ci_scripts /tmp/decord

# Pre-download CI test dependencies (cloned during image build to avoid
# network instability at test time).
RUN echo ">>> Pre-downloading transformers (commit 7a833d1)..." && \
    git clone https://github.com/huggingface/transformers.git /workspace/transformers && \
    cd /workspace/transformers && \
    git checkout 7a833d1 && \
    cd /workspace && \
    mv transformers transformers-7a833d1 && \
    echo ">>> Pre-downloading Megatron-LM (branch core_v0.12.1)..." && \
    git clone https://github.com/NVIDIA/Megatron-LM.git /workspace/Megatron-LM && \
    cd /workspace/Megatron-LM && \
    git checkout core_v0.12.1 && \
    cd /workspace && \
    mv Megatron-LM Megatron-LM_core_v0.12.1

# /workspace must NOT contain MindSpeed-MM source (the CI test code is mounted
# into ${WORKSPACE}/CODE by the CI platform, not pre-baked into the image).
RUN rm -rf /workspace/MindSpeed-MM

WORKDIR /workspace
ENV FINAL_WORKDIR=/workspace

# Ensure conda is in PATH and CANN toolkit is discoverable.
ENV PATH=/opt/conda/bin:$PATH
ENV ASCEND_TOOLKIT_HOME=/usr/local/Ascend/ascend-toolkit
