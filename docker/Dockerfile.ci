# ============================================
# Standalone MindSpeed-MM CI image
#
# Current supported platform:
#   - NPU: 910b
#   - CPU: aarch64
#   - OS:  openEuler
#
# This image is built directly from the CANN base image. Build tools, downloaded
# CANN installers, FLA sources, and compiler caches stay in ci-builder; the
# final stage contains only CI runtime content.
# ============================================

ARG BASE_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/cann:9.1.0-910b-openeuler24.03-py3.12
FROM ${BASE_IMAGE} AS ci-builder

USER root

ARG MINICONDA_SH
ARG DECORD_SCRIPT
ARG DECORD_DEPS_DIR=decord_deps
ARG DECORD_BUILD=true
ARG CANN_VERSION=9.1.0

RUN ARCH="$(uname -m)" && \
    . /etc/os-release && \
    ID_LOWER="$(echo "${ID}" | tr '[:upper:]' '[:lower:]')" && \
    test "${ARCH}" = "aarch64" && \
    echo "${ID_LOWER}" | grep -q "openeuler"

COPY configure_repo.sh /tmp/configure_repo.sh
RUN chmod +x /tmp/configure_repo.sh && \
    bash /tmp/configure_repo.sh && \
    rm -f /tmp/configure_repo.sh && \
    yum install -y git wget curl gawk && \
    yum clean all && \
    rm -rf /var/cache/yum

COPY ${MINICONDA_SH} /tmp/miniconda.sh
RUN bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm -f /tmp/miniconda.sh && \
    /opt/conda/bin/conda tos accept --override-channels \
        --channel https://repo.anaconda.com/pkgs/main && \
    /opt/conda/bin/conda tos accept --override-channels \
        --channel https://repo.anaconda.com/pkgs/r && \
    /opt/conda/bin/pip config set global.index-url \
        https://repo.huaweicloud.com/repository/pypi/simple && \
    /opt/conda/bin/pip config set global.trusted-host repo.huaweicloud.com

ENV PATH=/opt/conda/bin:$PATH
ENV CONDA_AUTO_UPDATE_CONDA=false
ENV CANN_VERSION=${CANN_VERSION}

# Build Decord once, retain its source for per-Python bindings, and collect only
# runtime shared objects for the final stage.
COPY ${DECORD_SCRIPT} /tmp/install_decord.sh
COPY ${DECORD_DEPS_DIR} /tmp/decord_deps/
RUN test "${DECORD_BUILD}" = "true" && \
    chmod +x /tmp/install_decord.sh && \
    bash /tmp/install_decord.sh /tmp/decord_deps && \
    mkdir -p /opt/decord_src /decord_artifacts/lib && \
    cp -a /tmp/decord/. /opt/decord_src/ && \
    cp -aL /usr/local/lib/*.so* /decord_artifacts/lib/ && \
    rm -rf /tmp/decord_deps /tmp/install_decord.sh \
        /root/ffmpeg_sources /root/ffmpeg_build /root/bin

# Build every configured Conda environment. Environments with a structured
# "fla" entry also receive a private CANN installation and an FLA wheel.
RUN yum install -y patch && \
    yum clean all && \
    rm -rf /var/cache/yum

COPY scripts/ci/ /tmp/ci_scripts/
RUN python /tmp/ci_scripts/build_ci_envs.py && \
    rm -rf /tmp/ci_scripts /root/.cache/pip /opt/conda/pkgs/*

# Pre-fetch only the revisions used by CI while retaining shallow .git metadata.
RUN mkdir -p /workspace/transformers-7a833d1 && \
    git -C /workspace/transformers-7a833d1 init && \
    git -C /workspace/transformers-7a833d1 remote add origin \
        https://github.com/huggingface/transformers.git && \
    git -C /workspace/transformers-7a833d1 fetch --depth 1 origin \
        7a833d1ccd41673030c85107f65f454c0c3222f5 && \
    git -C /workspace/transformers-7a833d1 checkout --detach FETCH_HEAD && \
    git clone --depth 1 --branch core_v0.12.1 \
        https://github.com/NVIDIA/Megatron-LM.git \
        /workspace/Megatron-LM_core_v0.12.1


# ============================================
# Final CI runtime image
# ============================================
FROM ${BASE_IMAGE} AS final

USER root

COPY configure_repo.sh /tmp/configure_repo.sh
RUN chmod +x /tmp/configure_repo.sh && \
    bash /tmp/configure_repo.sh && \
    rm -f /tmp/configure_repo.sh && \
    yum install -y git iproute wget curl gawk ffmpeg && \
    yum clean all && \
    rm -rf /var/cache/yum

COPY --from=ci-builder /opt/conda/ /opt/conda/
COPY --from=ci-builder /workspace/cann/ /workspace/cann/
COPY --from=ci-builder /workspace/transformers-7a833d1/ \
    /workspace/transformers-7a833d1/
COPY --from=ci-builder /workspace/Megatron-LM_core_v0.12.1/ \
    /workspace/Megatron-LM_core_v0.12.1/
COPY --from=ci-builder /decord_artifacts/lib/ /usr/local/lib/

RUN echo '/usr/local/lib' > /etc/ld.so.conf.d/mindspeed-ci-libs.conf && \
    ldconfig && \
    test -f /workspace/cann/ci_master/cann/set_env.sh && \
    /opt/conda/bin/conda clean -afy && \
    rm -rf /root/.cache/pip /opt/conda/pkgs/* /tmp/*

ENV PATH=/opt/conda/bin:$PATH
ENV CONDA_AUTO_UPDATE_CONDA=false
ENV ASCEND_TOOLKIT_HOME=/usr/local/Ascend/ascend-toolkit

WORKDIR /workspace
